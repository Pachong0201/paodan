# ===== LLM（OpenAI-compatible API）=====
# 不配置则自动使用离线 template 后端（确定性规则兜底，无外部调用）
LLM_ENABLED=1
LLM_MODE=template        # api | template
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini
LLM_TIMEOUT=60

# ===== OCR（tesseract 可选；未安装则图片/扫描PDF标记 skipped）=====
OCR_ENABLED=1
TESSERACT_CMD=tesseract

# ===== 流水线阈值 =====
LLM_TRIGGER_SCORE=35     # rule_score >= 35 进入 LLM
RULE_TRIGGER_EXTRA=1     # B:高价值Pattern / C:E+目标+金额 可低分触发 LLM（仍需 SafePayload）
MIN_PRIORITY=D           # 输出报告的最低优先级 S/A/B/C/D

# ===== 数据路径（可选覆盖） =====
# NEWS_SIGNAL_DIR=config/news_signal
# SCREENING_DB=data/news_screening.db
# KNOWN_CASES_FILE=data/known_cases.jsonl

# ===== 重要爆料邮件 Excel 台账 V3.1（可用 config/excel_register.yaml 覆盖） =====
# EXCEL_REGISTER_ENABLED=1
# EXCEL_REGISTER_PATH=data/reports/important_email_register.xlsx
# EXCEL_REGISTER_MIN_SCORE=60
# EXCEL_REGISTER_PRIORITIES=S,A,B
# EXCEL_REGISTER_BACKUP=1

# ===== 重要邮件待审查文件夹 V3.2（可用 config/review_queue.yaml 覆盖） =====
# REVIEW_QUEUE_ENABLED=1
# REVIEW_QUEUE_PATH=data/review_queue
# REVIEW_QUEUE_MIN_SCORE=60
# REVIEW_QUEUE_PRIORITIES=S,A,B

# ===== V4.1.1 External LLM Privacy Gateway =====
# 生产默认 STRUCTURED_ONLY；EXTERNAL 请求必须经 SafePayloadBuilder + OutboundGuard。
# REDACTED_SNIPPETS 为受限模式，生产推荐只使用 STRUCTURED_ONLY。
# 本版本禁止 ALLOW_RAW_EXTERNAL_LLM 之类的 raw external 绕过。
SECURITY_PRIVACY_LEVEL=STRUCTURED_ONLY
EXTERNAL_LLM_ENABLED=1
EXTERNAL_LLM_ALLOWED_HOSTS=api.openai.com
EXTERNAL_LLM_TRUSTED_LOCAL_HOSTS=localhost,127.0.0.1,::1
EXTERNAL_LLM_HTTPS_REQUIRED=1
EXTERNAL_LLM_ALLOW_SAFE_SNIPPETS=0
EXTERNAL_LLM_MAX_PAYLOAD_CHARS=12000
EXTERNAL_LLM_FAIL_CLOSED=1
SECURITY_AUDIT_ENABLED=1
SECURITY_AUDIT_LOG_PATH=logs/security_audit.jsonl

# ===== V4.2 Local Dashboard =====
# 默认只监听 127.0.0.1，禁止默认 0.0.0.0
DASHBOARD_ENABLED=1
DASHBOARD_HOST=127.0.0.1
DASHBOARD_PORT=8765
DASHBOARD_PAGE_SIZE=30
DASHBOARD_DEFAULT_DAYS=7
DASHBOARD_TIMEZONE=Asia/Shanghai
# 本版本不支持 remote；设置 0.0.0.0 会被拒绝
# DASHBOARD_ALLOW_REMOTE=0
